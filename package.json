{
  "name": "realtime-earth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A modular catalog of live global data feeds, displayed exactly as received.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "audit:bundle": "node scripts/check-bundle-secrets.mjs",
    "verify:endpoints": "node scripts/verify-endpoints.mjs",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wrangler": "^4.120.0"
  }
}
